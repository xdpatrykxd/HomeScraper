CHECK_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECONDS=25
REQUEST_CONCURRENCY=4
FILTERS_PATH=config/filters.yaml
DATABASE_PATH=data/listings.sqlite3

# Run python3 scripts/setup_env.py to generate a private gateway API key.
WAHA_API_KEY=
# Free WAHA Core. setup_env.py selects noweb-arm on Apple Silicon/ARM.
WAHA_IMAGE=devlikeapro/waha:noweb
WHATSAPP_GATEWAY_ENGINE=GOWS
WHATSAPP_GATEWAY_PORT=3010
# Used when running Python on the host; Compose overrides this with its service URL.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3010
WHATSAPP_SESSION=default
WHATSAPP_GATEWAY_TIMEOUT_SECONDS=60

# International phone numbers; the legacy whatsapp: prefix is also accepted.
WHATSAPP_RECIPIENT_1=
WHATSAPP_RECIPIENT_2=
# Optional comma-separated phones and/or group IDs, or add WHATSAPP_RECIPIENT_3, etc.
WHATSAPP_RECIPIENTS=
# Optional comma-separated group IDs from python -m app.gateway groups.
# Groups can be used alone (leave phone recipient variables empty) or alongside phones.
WHATSAPP_GROUP_IDS=
